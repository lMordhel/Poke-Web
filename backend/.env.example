# Backend (FastAPI). Copiar este archivo a `backend/.env`.
# Los valores son para desarrollo local; en un despliegue hay que cambiarlos.

# --- Base de datos ------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=webpoke

# --- Seguridad (JWT) ----------------------------------------------
# Obligatorio. Generar uno largo y aleatorio por entorno, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=cambia-esta-clave-en-cada-entorno
JWT_ALG=HS256

# Expiración de tokens, en minutos (15 min de acceso, 30 días de refresh).
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_MIN=43200

# --- Entorno de ejecución -----------------------------------------
# local: cookies sin `Secure` y CORS de localhost.
# production: cookies con `Secure`, solo sobre HTTPS.
ENVIRONMENT=local

# --- CORS ---------------------------------------------------------
# Lista explícita de orígenes autorizados, separados por coma. Sin comodines.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Archivos subidos ---------------------------------------------
# Origen público del backend: base de las URLs que devuelve
# `POST /products/upload-image`. Debe ser alcanzable desde el navegador.
PUBLIC_BASE_URL=http://localhost:8000
